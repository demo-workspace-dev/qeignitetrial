            </focus-ctd-cond>
        </if-expr>
        <then-expr is_or="false">
            <focus-ctd-cond attribute="order_status" operation="Doesn't Equal">
                <focus-ctd-cond-val value="BACKORDERED"/>
            </focus-ctd-cond>
        </then-expr>
    </restriction>
