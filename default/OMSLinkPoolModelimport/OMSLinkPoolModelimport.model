    <restriction expression="!(inventory_reservation.equals(&quot;Not_Reserved&quot;)) || !order_status.equals(&quot;ALLOCATED&quot;)" group="" groupedExpression="!(inventory_reservation.equals(&quot;Not_Reserved&quot;)) || !order_status.equals(&quot;ALLOCATED&quot;)" iff="false" isActive="true" isAutoGenerated="false" name="" type="If-Then">
        <requirement ID="OMS-001"/>
        <if-expr is_or="false">
            <focus-ctd-cond attribute="inventory_reservation" operation="Equals">
                <focus-ctd-cond-val value="Not_Reserved"/>
            </focus-ctd-cond>
        </if-expr>
        <then-expr is_or="false">
            <focus-ctd-cond attribute="order_status" operation="Doesn't Equal">
                <focus-ctd-cond-val value="ALLOCATED"/>
            </focus-ctd-cond>
        </then-expr>
    </restriction>
    <restriction expression="!(single_warehouse_inventory.equals(&quot;Full_Inventory&quot;)) || !order_status.equals(&quot;BACKORDERED&quot;)" group="" groupedExpression="!(single_warehouse_inventory.equals(&quot;Full_Inventory&quot;)) || !order_status.equals(&quot;BACKORDERED&quot;)" iff="false" isActive="true" isAutoGenerated="false" name="" type="If-Then">
