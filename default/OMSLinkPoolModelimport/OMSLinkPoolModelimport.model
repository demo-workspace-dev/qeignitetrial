    </restriction>
    <restriction expression="!(pickup_confirmation.equals(&quot;Not_Confirmed&quot;)) || !shipment_status.equals(&quot;IN_TRANSIT&quot;)" group="" groupedExpression="!(pickup_confirmation.equals(&quot;Not_Confirmed&quot;)) || !shipment_status.equals(&quot;IN_TRANSIT&quot;)" iff="false" isActive="true" isAutoGenerated="false" name="" type="If-Then">
