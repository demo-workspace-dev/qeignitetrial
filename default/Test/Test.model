<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE focus-model [
]>
<!----><focus-model auxDataFilesFolder="" classifyAttributesEnabled="false" frea_ai_smart_comment="" inputOutput="false" manual="true">
    <model-identification modelTag="@default @V1 @default_Sample @Test">
        <model-identification-field name="Application Name" partOfTag="true" value="default"/>
        <model-identification-field name="Application code version #" partOfTag="true" value="V1"/>
        <model-identification-field name="Application Function" partOfTag="true" value="default_Sample"/>
        <model-identification-field name="Updated Reason" partOfTag="false" value="New Model"/>
        <model-identification-field name="Created By" partOfTag="false" value="dbhadra2"/>
        <model-identification-field name="Created Date and Time" partOfTag="false" value="13 Nov 2026 12:00:12"/>
        <model-identification-field name="Updated By" partOfTag="false" value="dbhadra2"/>
        <model-identification-field name="Updated Date and Time" partOfTag="false" value="13 Nov 2026 12:24:19"/>
        <model-identification-field name="Application Sub Function" partOfTag="true" value="Test"/>
        <model-identification-field name="Test Stage" partOfTag="false" value=""/>
        <model-identification-field name="Criticality" partOfTag="false" value=""/>
        <model-identification-field name="Project" partOfTag="false" value=""/>
        <model-identification-field name="Epic" partOfTag="false" value=""/>
        <model-identification-field name="Feature" partOfTag="false" value=""/>
        <model-identification-field name="User Story" partOfTag="false" value=""/>
        <model-identification-field name="Git Comments" partOfTag="false" value=""/>
        <model-identification-field name="Use attribute pool" partOfTag="false" value="false"/>
    </model-identification>
    <attribute attr_class="NONE" dependencies="false" description="" group="" iotype="NEITHER" name="UserName" parentDetailsApplicationName="" parentDetailsFunctionality="" parentDetailsModel="" parentDetailsModelTag="@default @V1 @default_Sample @Test" parentDetailsPortfolio="" parentDetailsTenantId="" parentDetailsUsername="" poolId="" revision="" type="STRING">
        <value name="Valid_value" neg-value="false" weight="1"/>
        <value name="Invalid_value" neg-value="false" weight="1"/>
    </attribute>
    <attribute attr_class="NONE" dependencies="false" description="" group="Password" iotype="NEITHER" name="Password" parentDetailsApplicationName="" parentDetailsFunctionality="" parentDetailsModel="" parentDetailsModelTag="@default @V1 @default_Sample @Test" parentDetailsPortfolio="" parentDetailsTenantId="" parentDetailsUsername="" poolId="" revision="" type="STRING">
        <value name="Valid_value" neg-value="false" weight="1"/>
        <value name="Invalid_value" neg-value="false" weight="1"/>
    </attribute>
    <coverage-reqs-sets defaultCoverageRequirementsSet="Level_1">
        <coverage-reqs-set description="Level_1" name="Level_1">
            <coverage-req>
                <attribute name="UserName"/>
                <attribute name="Password"/>
                <coverage-goal coverage-goal-val="1"/>
            </coverage-req>
        </coverage-reqs-set>
    </coverage-reqs-sets>
    <neg-coverage-reqs-sets defaultCoverageRequirementsSet="SingleNegativeCoverageRequirementsSet" isAutoNegCoverageRequirements="true">
        <coverage-reqs-set description="" name="SingleNegativeCoverageRequirementsSet"/>
    </neg-coverage-reqs-sets>
    <focus-ctd-decoration decorationName="DefaultTestCaseNameDecoration" decorationType="testCaseName" isActiveDecoration="false"/>
    <focus-ctd-decoration decorationName="DefaultFreeStyleDecoration" decorationType="freeStyle" isActiveDecoration="true"/>
    <focus-ctd-decoration decorationName="DefaultCucumberDecoration" decorationType="cucumberDecoration" isActiveDecoration="false"/>
    <focus-ctd-decoration decorationName="DefaultStructuredDecoration" decorationType="structuredDecoration" isActiveDecoration="false"/>
    <deactivates/>
    <attrs-to-delete/>
    <pool_comments/>
    <db-dependencies/>
    <focus-ctd-model-sync>
        <focus-ctd-model-sync-mult/>
        <focus-ctd-model-sync-na/>
    </focus-ctd-model-sync>
</focus-model>
